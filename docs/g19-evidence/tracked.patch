diff --git a/code/proportion_test.py b/code/proportion_test.py
index feda459..7c8f477 100644
--- a/code/proportion_test.py
+++ b/code/proportion_test.py
@@ -45,17 +45,18 @@ def prop_2sample(n1=None, n2=None, e1=None,
 
     mode = int((n1 + 1) * (e1 + e2 + 1) / (n1 + n2 + 2))
     observed_probability = rv.pmf(e1)
+    lower, upper = rv.support()
 
     if e1 == mode:
         p_f = 1
     elif e1 < mode:
         y = mode
-        while rv.pmf(y) >= observed_probability:
+        while y <= upper and rv.pmf(y) >= observed_probability:
             y += 1
         p_f = rv.cdf(e1) + 1 - rv.cdf(y - 1)
     else:
         y = mode
-        while rv.pmf(y) >= observed_probability:
+        while y >= lower and rv.pmf(y) >= observed_probability:
             y -= 1
         p_f = 1 - rv.cdf(e1 - 1) + rv.cdf(y)
 
diff --git a/tests/test_g9_tables.py b/tests/test_g9_tables.py
index f9a1b53..c9b968e 100644
--- a/tests/test_g9_tables.py
+++ b/tests/test_g9_tables.py
@@ -145,6 +145,15 @@ class ComputationOnly(ast.NodeTransformer):
 
 def computation_hash(module):
     tree = ast.parse((ROOT / 'code' / f'{module}.py').read_bytes())
+    if module == 'proportion_test':
+        # G19 只放行 Fisher 支持集终止保护；数值/报告旧基线和其余 AST 保持冻结。
+        function = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'prop_2sample')
+        function.body = [n for n in function.body if ast.unparse(n) != 'lower, upper = rv.support()']
+        for node in ast.walk(function):
+            if isinstance(node, ast.While) and ast.unparse(node.test) in (
+                    'y <= upper and rv.pmf(y) >= observed_probability',
+                    'y >= lower and rv.pmf(y) >= observed_probability'):
+                node.test = node.test.values[1]
     if module == 'chi2_dialog':
         # 此 Dialog 的报告没有 print_out 分支；由固定 TXT 和原有路由测试验证。
         return None
