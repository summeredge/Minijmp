+    ucl_list = [p_bar + 3 * (p_bar * (1 - p_bar) / i)**.5 for i in nlist]
+    lcl_list = [max(0, p_bar - 3 * (p_bar * (1 - p_bar) / i)**.5)
+                for i in nlist]
