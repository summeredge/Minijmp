+def display_value(value, column):
+    if isinstance(value, Real):
+        if not math.isfinite(value):
+            return '*'
+        return str(int(value)) if column in ('N', 'N*', '众数频数') else f'{value:.3f}'
+    return '*' if value is None else str(value)
