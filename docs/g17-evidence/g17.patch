+{
+  "df_combine.py:df_combine": "def df_combine(df1, df2, ins_x=0, ins_y=0):\n    df1h, df1w = df1.shape\n    df2h, df2w = df2.shape\n    h = max(df1h, ins_y + df2h)\n    w = max(df1w, ins_x + df2w)\n    res = [[np.nan] * w for i in range(h)]\n    for y in range(df1h):\n        for x in range(df1w):\n            res[y][x] = df1.iloc[y, x]\n    for y in range(df2h):\n        for x in range(df2w):\n            res[y + ins_y][x + ins_x] = df2.iloc[y, x]\n    cols = df1.columns.tolist()\n    for i in range(w - df1w):\n        cols.append(\"C%d\" % (i + 1 + df1w))\n    return pd.DataFrame(res, columns=cols, index=range(h))",
+  "utilities.py:number_2Dlist": "def number_2Dlist(df=None, cols=None,\n                  print_out=False, print_port=print):\n    n = df[cols[0]].shape[0]\n    res = []\n    for i in range(n):\n        r = []\n        for col in cols:\n            try:\n                _ = float(df[col].iloc[i])\n                if _ > 0 or _ <= 0:\n                    r.append(_)\n            except BaseException:\n                pass\n        if len(r) == len(cols):\n            res.append(r)\n    if print_out:\n        print = print_port\n        print(\"Received %d cols of data. Found %d rows valid.\" % (\n            len(cols), len(res)))\n    return transpose_2D_list(res)",
+  "dialog.py:find": "def find(self):\n        \"\"\"Do string search. Creates a masked dataframe for results and then stores each cell\n        coordinate in a list.\"\"\"\n\n        table = self.table\n        df = table.model.df\n        df = df.astype('object').astype('str')\n        s = self.searchvar.get()\n        case = self.casevar.get()\n        self.search_changed = False\n        self.clear()\n        if s == '':\n            return\n        s = s if case else s.upper()\n        found = df.copy()\n        for y in range(df.shape[0]):\n            for x in range(df.shape[1]):\n                found.iloc[y, x] = False\n                if is_void(df.iloc[y, x]):\n                    continue\n                a = str(df.iloc[y, x]) if case else str(df.iloc[y, x]).upper()\n                found.iloc[y, x] = (a == s)\n\n        table.highlighted = found\n        self.coords = [(x, y) for y in range(df.shape[0])\n                       for x in range(df.shape[1]) if found.iloc[y, x]]\n        self.current = 0\n        return",
+  "pandastable_local/dialogs.py:find": "def find(self):\n        \"\"\"Do string search. Creates a masked dataframe for results and then stores each cell\n        coordinate in a list.\"\"\"\n\n        table = self.table\n        df = table.model.df\n        df = df.astype('object').astype('str')\n        s = self.searchvar.get()\n        case = self.casevar.get()\n        self.search_changed = False\n        self.clear()\n        if s == '':\n            return\n        found = pd.DataFrame()\n        for col in df:\n            found[col] = df[col].str.contains(s, na=False, case=case)\n        #set the masked dataframe so that highlighted cells are shown on redraw\n        table.highlighted = found\n        i=0\n        self.coords = []\n        for r,row in found.iterrows():\n            j=0\n            for col,val in row.iteritems():\n                if val is True:\n                    #print (r,col,val, i, j)\n                    self.coords.append((i,j))\n                j+=1\n            i+=1\n        self.current = 0\n        return",
+  "pandastable_local/csv_import.py:read_records": "def read_records(text, delimiter):\n    if '\\x00' in text:\n        raise ValueError(\"文件包含 NUL 字符，请检查编码或使用 Advanced Import。\")\n    rows = [row for row in csv.reader(io.StringIO(text, newline=\"\"),\n                                     delimiter=delimiter, strict=True) if row]\n    if not rows or not rows[0]:\n        raise ValueError(\"文件为空。\")\n    width = len(rows[0])\n    for line, row in enumerate(rows, 1):\n        if len(row) != width:\n            raise ValueError(f\"第 {line} 条记录有 {len(row)} 列，预期 {width} 列。请检查分隔符或使用 Advanced Import。\")\n    return rows",
+  "pandastable_local/csv_import.py:detect_csv": "def detect_csv(filename):\n    raw = Path(filename).read_bytes()\n    uncertain_encoding = False\n    if raw.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):\n        encoding = \"utf-16\"\n    else:\n        encoding = \"utf-8-sig\"\n        try:\n            raw.decode(encoding)\n        except UnicodeDecodeError:\n            uncertain_encoding = True\n            try:\n                raw.decode(\"gb18030\")\n                encoding = \"gb18030\"\n            except UnicodeDecodeError:\n                encoding = \"cp1252\"\n    text = raw.decode(encoding)\n    candidates = []\n    for delimiter in DELIMITERS.values():\n        try:\n            rows = read_records(text, delimiter)\n        except (ValueError, csv.Error):\n            continue\n        if len(rows[0]) > 1:\n            candidates.append(delimiter)\n    delimiter = candidates[0] if candidates else \",\"\n    # Validate the entire file before a worksheet can be replaced.\n    rows = read_records(text, delimiter)\n    header = None\n    if len(rows) > 1:\n        first = rows[0]\n        numeric = lambda value: bool(NUMBER.fullmatch(value))\n        if all(numeric(v) for row in rows for v in row):\n            header = False\n        elif (all(first) and len(set(first)) == len(first)\n              and not any(numeric(v) for v in first)\n              and any(all(not row[col] or numeric(row[col]) for row in rows[1:])\n                      and any(row[col] for row in rows[1:])\n                      for col in range(len(first)))):\n            header = True\n    return dict(encoding=encoding, delimiter=delimiter, header=header,\n                confirm=uncertain_encoding or len(candidates) != 1 or header is None)",
+  "pandastable_local/csv_import.py:read_csv": "def read_csv(filename, encoding, delimiter, header):\n    text = Path(filename).read_bytes().decode(encoding)\n    rows = read_records(text, delimiter)\n    names = rows.pop(0) if header else list(range(len(rows[0])))\n    if header and (not all(names) or len(set(names)) != len(names)):\n        raise ValueError(\"表头包含空名称或重复名称，请取消首行表头选项或使用 Advanced Import。\")\n    frame = pd.DataFrame(rows, columns=names)\n    for col in frame:\n        values = frame[col]\n        present = values[values != \"\"]\n        # Preserve identifiers and long integers instead of rounding them as floats.\n        if len(present) and all(NUMBER.fullmatch(v) and\n                                (\".\" in v or \"e\" in v.lower() or\n                                 len(v.lstrip(\"+-\")) <= 15) for v in present):\n            converted = pd.to_numeric(values.replace(\"\", float(\"nan\")), errors=\"coerce\")\n            if converted[present.index].notna().all() and not converted.isin([float(\"inf\"), -float(\"inf\")]).any():\n                frame[col] = converted\n                continue\n        frame[col] = values.replace(\"\", float(\"nan\"))\n    return frame"
+}
