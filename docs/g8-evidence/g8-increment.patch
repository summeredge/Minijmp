+                raise ValueError('数字格式必须为与列名等长的非空字符串序列')
+        if text is None:
+            from prettytable import PrettyTable
+            text = PrettyTable(headers)
+            text.add_rows(display)
+            text.align = 'r'
+            text.align[headers[0]] = 'l'
